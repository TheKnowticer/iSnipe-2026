		itemDef
		{
			name "class_choose_1"
			rect -64 28 336 20 1 1
			group "mw2_button"
			style 1
			visible 1
			forecolor 1 1 1 1
			disablecolor 0.6 0.55 0.55 1
			background "menu_button_selection_bar"
			type 1
			textfont 3
			textalign 6
			textalignx -60
			textscale 0.375
			text "Intervention"
			action
			{
				play "mouse_click";
				scriptmenuresponse "class0";
				close self;
			}
			onFocus
			{
				play "mouse_over";
				if ( dvarstring( "gameMode" ) != "mp" )
				{
					setItemColor "mw2_button" backcolor 0 0 0 0;
				}
				setItemColor self backcolor 0 0 0 1;
				setLocalVarBool "ui_menuAButton" ( 1 );
				setLocalVarFloat "ui_popupYPos" ( getfocuseditemy( ) );
				setLocalVarString "loadoutPrimary" ( "cheytac" );
				setLocalVarString "loadoutPrimaryAttachment" ( "fmj" );
				setLocalVarString "loadoutPrimaryAttachment2" ( "xmags" );
				if ( localvarstring( "loadoutPrimaryAttachment2" ) == "" )
				{
					setLocalVarString "loadoutPrimaryAttachment2" ( "none" );
				}
				setLocalVarString "loadoutPrimaryCamo" ( "none" );
				setLocalVarString "loadoutSecondary" ( "deserteagle" );
				setLocalVarString "loadoutSecondaryAttachment" ( "tactical" );
				setLocalVarString "loadoutSecondaryAttachment2" ( "none" );
				if ( localvarstring( "loadoutSecondaryAttachment2" ) == "" )
				{
					setLocalVarString "loadoutSecondaryAttachment2" ( "none" );
				}
				setLocalVarString "loadoutSecondaryCamo" ( "none" );
				setLocalVarString "loadoutEquipment" ( "throwingknife_mp" );
				setLocalVarString "loadoutPerk1" ( "specialty_fastreload" );
				setLocalVarString "loadoutPerk2" ( "specialty_bulletdamage" );
				setLocalVarString "loadoutPerk3" ( "specialty_bulletaccuracy" );
				setLocalVarString "loadoutStreak1" ( "none" );
				setLocalVarString "loadoutStreak2" ( "none" );
				setLocalVarString "loadoutStreak3" ( "none" );
				setLocalVarString "loadoutDeathStreak" ( "specialty_null" );
				setLocalVarString "loadoutOffhandSecondary" ( "none" );
				setLocalVarString "loadoutClassName" ( "Intervention" );
			}
			leaveFocus
			{
				setItemColor self backcolor 0 0 0 "0.0";
				setLocalVarString "ui_hint_text" ( "@NULL_EMPTY" );
				setLocalVarBool "ui_menuAButton" ( 0 );
			}
		}

