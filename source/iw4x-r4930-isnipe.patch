+	static std::string ISnipeAnnouncementText(const char* value, const Game::gentity_s* player)
+	{
+		std::string text = value ? value : "";
+		const auto replaceAll = [&text](const std::string& token, const std::string& replacement)
+		{
+			std::size_t pos = 0;
+			while ((pos = text.find(token, pos)) != std::string::npos)
+			{
+				text.replace(pos, token.size(), replacement);
+				pos += replacement.size();
+			}
+		};
+		if (player && player->client)
+			replaceAll("{player}", player->client->sess.cs.name);
+		const auto* hostname = Game::Dvar_FindVar("sv_hostname");
+		if (hostname && hostname->current.string)
+			replaceAll("{server}", hostname->current.string);
+		// Keep chat commands well formed even for names containing quotes.
+		for (auto& ch : text)
+		{
+			if (ch == '"' || ch == '\\' || static_cast<unsigned char>(ch) < 32)
+				ch = ' ';
+		}
+		if (text.size() > 200) text.resize(200);
+		return text;
+	}
+
