+	// RCON-only panel commands: validate the current connection in the same
+	// server frame as a kick/ban so a reused client slot cannot target another
+	// connection. The panel never submits player names as console commands.
+	static void ISnipeRegisterPanelCommands()
+	{
+		Command::AddSV("isnipePanelPlayers", [](const Command::Params*)
+		{
+			nlohmann::json players = nlohmann::json::array();
+			for (int i = 0; i < Game::MAX_CLIENTS; ++i)
+			{
+				const auto& cl = Game::svs_clients[i];
+				if (cl.header.state < Game::CS_ACTIVE || !cl.gentity || !cl.gentity->client) continue;
+				players.push_back({{"slot", i}, {"guid", std::format("{:016X}", cl.steamID)},
+					{"session", cl.lastConnectTime}, {"challenge", cl.challenge},
+					{"name", std::string(cl.name, strnlen(cl.name, sizeof(cl.name)))},
+					{"bot", cl.bIsTestClient != 0}, {"ping", cl.ping},
+					{"score", Game::SV_GameClientNum_Score(i)}});
+			}
+			Logger::Print("ISNIPE_PLAYERS:{}\n", players.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace));
+		});
+
+		const auto moderate = [](const Command::Params* params, const bool ban)
+		{
+			if (params->size() != 5)
+			{
+				Logger::Print("ISNIPE_PANEL_ERROR:Invalid identity\n");
+				return;
+			}
+			const std::string slotText = params->get(1);
+			if (slotText.empty() || slotText.size() > 2 || slotText.find_first_not_of("0123456789") != std::string::npos)
+			{
+				Logger::Print("ISNIPE_PANEL_ERROR:Invalid slot\n");
+				return;
+			}
+			const auto slot = std::strtoul(slotText.c_str(), nullptr, 10);
+			if (slot >= Game::MAX_CLIENTS)
+			{
+				Logger::Print("ISNIPE_PANEL_ERROR:Invalid slot\n");
+				return;
+			}
+			auto* cl = &Game::svs_clients[slot];
+			if (cl->header.state < Game::CS_ACTIVE || std::format("{:016X}", cl->steamID) != params->get(2) ||
+				std::to_string(cl->lastConnectTime) != params->get(3) || std::to_string(cl->challenge) != params->get(4))
+			{
+				Logger::Print("ISNIPE_PANEL_ERROR:Player connection changed; refresh and try again\n");
+				return;
+			}
+			if (ban && cl->bIsTestClient)
+			{
+				Logger::Print("ISNIPE_PANEL_ERROR:Test bots cannot be banned\n");
+				return;
+			}
+			if (ban) Bans::BanClient(cl, "EXE_ERR_BANNED_PERM");
+			else Game::SV_DropClient(cl, "EXE_PLAYERKICKED", true);
+			Logger::Print("ISNIPE_PANEL_OK:{}\n", ban ? "banned" : "kicked");
+		};
+		Command::AddSV("isnipePanelKick", [moderate](const Command::Params* params) { moderate(params, false); });
+		Command::AddSV("isnipePanelBan", [moderate](const Command::Params* params) { moderate(params, true); });
+
+		Command::AddSV("isnipePanelSay", [](const Command::Params* params)
+		{
+			if (params->size() != 2) { Logger::Print("ISNIPE_PANEL_ERROR:Invalid message\n"); return; }
+			const std::string encoded = params->get(1);
+			if (encoded.empty() || encoded.size() > 400 || encoded.size() % 2 || encoded.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos)
+			{
+				Logger::Print("ISNIPE_PANEL_ERROR:Invalid message\n"); return;
+			}
+			std::string text;
+			for (std::size_t i = 0; i < encoded.size(); i += 2)
+				text.push_back(static_cast<char>(std::strtoul(encoded.substr(i, 2).c_str(), nullptr, 16)));
+			text = ISnipeAnnouncementText(text.c_str(), nullptr);
+			Game::SV_GameSendServerCommand(-1, Game::SV_CMD_CAN_IGNORE, Utils::String::Format("{:c} \"{}\"", 0x68, text));
+			Logger::Print("ISNIPE_PANEL_OK:announcement sent\n");
+		});
+	}
