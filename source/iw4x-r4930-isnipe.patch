+	// Set Marathon's replicated effect bit without replacing the normal perk slot.
+	void PlayerMovement::GScr_ISnipeGrantMarathon(const Game::scr_entref_t entref)
+	{
+		auto* ent = Game::GetEntity(entref);
+		if (!ent || !ent->client)
+		{
+			Game::Scr_Error("ISnipeGrantMarathon can only be called on a player");
+			return;
+		}
+		constexpr unsigned int index = Game::PERK_MARATHON;
+		ent->client->ps.perks[index >> 5] |= (1u << (index & 31));
+	}
+
